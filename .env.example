# Copy to .env and set real values. docker compose and scripts/start_local.sh read it; .env is git-ignored.
# Required: the system refuses to start without them. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password
ADMIN_USERNAME=admin
# Only used to create the first administrator: 12+ characters, changed at first sign-in.
ADMIN_PASSWORD=replace-with-a-strong-initial-password
# Running without Docker (scripts/start_local.sh): the local Postgres database.
# DATABASE_URL=postgresql+psycopg2://USER@127.0.0.1:5432/hrh_db
# Interactive API docs at /api/docs; leave off on anything reachable by others.
# ENABLE_API_DOCS=false
SMS_GATEWAY_TYPE=mock
# Twilio (only when SMS_GATEWAY_TYPE=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
EXPOSE_DEV_OTP=false
